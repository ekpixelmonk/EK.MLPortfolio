@model ProjectPageViewModel
@{
    var p = Model.Project;
    ViewData["Title"] = p.Title;
    ViewData["Description"] = p.Summary;
    var hasCharts = p.Charts.Count > 0;
    var hasLinks = !string.IsNullOrWhiteSpace(Model.CodeUrl) || !string.IsNullOrWhiteSpace(Model.NotebookUrl) || Model.Related.Count > 0;
}

<article class="container project-page">
    <a class="back-link" asp-controller="Home" asp-action="Index" asp-fragment="projects">&larr; All projects</a>

    <header class="project-header">
        <div class="badges">
            <span class="status status-@p.Status">@p.StatusLabel</span>
            <span class="domain-label">@(p.DomainLabel ?? (p.Category == ProjectCategories.Zoo ? "Model Zoo" : "Flagship ML"))</span>
        </div>
        <h1 class="project-page-title">@p.Title</h1>
        <p class="hero-sub">@p.Summary</p>
        <ul class="tag-list" aria-label="Tags">
            @foreach (var t in p.Tags)
            {
                <li>@t</li>
            }
        </ul>
        @if (!string.IsNullOrWhiteSpace(Model.CodeUrl))
        {
            <a class="btn-accent" href="@Model.CodeUrl" rel="noopener" target="_blank">View on GitHub</a>
        }
    </header>

    @if (Model.Reading is { } reading)
    {
        <section class="reading" aria-labelledby="reading-heading">
            <h2 id="reading-heading" class="visually-hidden">Current reading</h2>
            <p class="reading-sentence">
                The model predicts the current regime as:
                <strong class="reading-label">@reading.Label</strong>
                <span class="reading-tag">(illustrative)</span>
            </p>
            <p class="reading-meta">As of the market close on @reading.AsOf.ToString("d MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture). A reading of that day's indicators, not a forecast.</p>
            <ul class="reading-probs" aria-label="Probability of each regime">
                @foreach (var (name, prob) in reading.Probabilities)
                {
                    <li>
                        <span class="reading-prob-name">@name</span>
                        <span class="reading-prob-bar" aria-hidden="true"><span style="width:@((prob * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
                        <span class="reading-prob-value">@((prob * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture))%</span>
                    </li>
                }
            </ul>
            <details class="reading-inputs">
                <summary>The indicators behind this reading</summary>
                <ul>
                    @foreach (var input in reading.Inputs)
                    {
                        <li><span>@input.Label</span> <strong>@input.Value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)</strong></li>
                    }
                </ul>
            </details>
        </section>
    }

    <section class="page-section" aria-labelledby="summary-heading">
        <h2 id="summary-heading" class="section-title">Summary</h2>
        @if (Model.ContentHtml is not null)
        {
            <div class="prose">@Html.Raw(Model.ContentHtml)</div>
        }
        else
        {
            <p class="text-secondary">A write-up for this project hasn't been published yet.</p>
        }
    </section>

    @if (hasCharts)
    {
        <section class="page-section" aria-labelledby="viz-heading">
            <h2 id="viz-heading" class="section-title">Visualizations</h2>
            <div class="gallery">
                @foreach (var chart in p.Charts)
                {
                    <figure class="gallery-item">
                        <a href="@Url.Content($"~/projects/{p.Slug}/charts/{chart.File}")" target="_blank" rel="noopener">
                            <img src="@Url.Content($"~/projects/{p.Slug}/charts/{chart.File}")" alt="@chart.Caption" loading="lazy" />
                        </a>
                        <figcaption>@chart.Caption</figcaption>
                    </figure>
                }
            </div>
        </section>
    }

    @if (Model.Schema is not null)
    {
        <section class="page-section" aria-labelledby="try-heading">
            <h2 id="try-heading" class="section-title">Try the model</h2>
            @await Html.PartialAsync("_TryModel", (Project: p, Schema: Model.Schema, Enabled: Model.FormEnabled))
            @if (!string.IsNullOrWhiteSpace(Model.CodeUrl))
            {
                <p class="code-link">
                    <span class="text-secondary">See how this model is built:</span>
                    <a href="@Model.CodeUrl" rel="noopener" target="_blank">View the code on GitHub &rarr;</a>
                    @if (!string.IsNullOrWhiteSpace(Model.NotebookUrl))
                    {
                        <span class="text-secondary">&middot;</span>
                        <a href="@Model.NotebookUrl" rel="noopener" target="_blank">Notebook</a>
                    }
                </p>
            }
        </section>
    }

    @if (hasLinks)
    {
        <section class="page-section" aria-labelledby="links-heading">
            <h2 id="links-heading" class="section-title">Links</h2>
            <ul class="link-list">
                @if (!string.IsNullOrWhiteSpace(Model.CodeUrl))
                {
                    <li><a href="@Model.CodeUrl" rel="noopener" target="_blank">GitHub repository</a></li>
                }
                @if (!string.IsNullOrWhiteSpace(Model.NotebookUrl))
                {
                    <li><a href="@Model.NotebookUrl" rel="noopener" target="_blank">Notebook</a></li>
                }
            </ul>
            @if (Model.Related.Count > 0)
            {
                <h3 class="subsection-title">Related projects</h3>
                <ul class="link-list">
                    @foreach (var r in Model.Related)
                    {
                        <li><a href="@Url.Content("~/projects/" + r.Slug)">@r.Title</a> <span class="text-secondary">&middot; @r.Summary</span></li>
                    }
                </ul>
            }
        </section>
    }

    @if (p.Disclaimer == "finance")
    {
        <aside class="disclaimer" role="note">
            <strong>Disclaimer.</strong> Educational purposes only. Not investment advice.
        </aside>
    }
</article>

@section Scripts {
    @if (Model.Schema is not null)
    {
        <script src="~/js/project.js" asp-append-version="true"></script>
    }
}

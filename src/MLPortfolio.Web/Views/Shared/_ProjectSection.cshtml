@model (string Title, string Id, IReadOnlyList<ProjectMeta> Projects)

@if (Model.Projects.Count > 0)
{
    <section class="project-section" data-section="@Model.Id" aria-labelledby="section-@Model.Id">
        <h3 id="section-@Model.Id" class="section-title">@Model.Title</h3>
        <div class="project-grid">
            @foreach (var p in Model.Projects)
            {
                var searchText = string.Join(' ', new[] { p.Title, p.Summary }.Concat(p.Tags)).ToLowerInvariant();
                <article class="project-card"
                         data-tags="@string.Join('|', p.Tags.Select(t => t.ToLowerInvariant()))"
                         data-search="@searchText">
                    <div class="project-thumb">
                        @if (p.ThumbnailPath is not null)
                        {
                            <img src="@Url.Content(p.ThumbnailPath)" alt="" loading="lazy" width="320" height="180" />
                        }
                    </div>
                    <div class="project-body">
                        <span class="status status-@p.Status">@p.StatusLabel</span>
                        <h4 class="project-title">
                            <a class="stretched-link" href="@Url.Content("~/projects/" + p.Slug)">@p.Title</a>
                        </h4>
                        <p class="project-summary">@p.Summary</p>
                        <ul class="tag-list" aria-label="Tags">
                            @foreach (var t in p.Tags)
                            {
                                <li>@t</li>
                            }
                        </ul>
                    </div>
                </article>
            }
        </div>
    </section>
}

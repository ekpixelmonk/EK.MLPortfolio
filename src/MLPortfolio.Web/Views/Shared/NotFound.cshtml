@{
    ViewData["Title"] = "Page not found";
}

<section class="container page-message">
    <p class="eyebrow">404</p>
    <h1 class="hero-title">We couldn't find that page.</h1>
    <p class="hero-sub">The project or page you're looking for doesn't exist, or it may have moved.</p>
    <p class="mt-4"><a class="btn-link-accent" asp-controller="Home" asp-action="Index" asp-fragment="projects">Browse all projects</a></p>
</section>

@using Microsoft.Extensions.Options
@inject IOptions<SiteOptions> SiteConfig
@{
    var site = SiteConfig.Value;
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrEmpty(pageTitle) ? $"{site.OwnerName} · ML Portfolio" : $"{pageTitle} · {site.OwnerName}";
    var description = ViewData["Description"] as string ?? site.Description;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@fullTitle</title>
    <meta name="description" content="@description" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@description" />
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="light dark" />
    <script>
        // Apply the saved or system theme before first paint to avoid a flash.
        (function () {
            var theme = "light";
            try {
                theme = localStorage.getItem("theme") ||
                    (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            } catch (e) { }
            document.documentElement.setAttribute("data-bs-theme", theme);
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
        <div class="container d-flex align-items-center justify-content-between py-3">
            <a class="site-brand" asp-controller="Home" asp-action="Index">@site.OwnerName</a>
            <nav aria-label="Primary" class="d-flex align-items-center gap-3 gap-sm-4">
                <a class="site-link" asp-controller="Home" asp-action="Index" asp-fragment="projects">Projects</a>
                @if (!string.IsNullOrWhiteSpace(site.GitHubUrl))
                {
                    <a class="site-link" href="@site.GitHubUrl" rel="noopener" target="_blank">GitHub</a>
                }
                @if (!string.IsNullOrWhiteSpace(site.LinkedInUrl))
                {
                    <a class="site-link" href="@site.LinkedInUrl" rel="noopener" target="_blank">LinkedIn</a>
                }
                <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Switch to dark theme" title="Toggle theme">
                    <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                </button>
            </nav>
        </div>
    </header>

    <main id="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container py-4 d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>&copy; @DateTime.UtcNow.Year @site.OwnerName</span>
            <span>Built with ASP.NET Core, ONNX Runtime and scikit-learn.</span>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

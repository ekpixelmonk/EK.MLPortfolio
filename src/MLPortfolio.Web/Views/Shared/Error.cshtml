@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="container page-message">
    <h1 class="hero-title">Something went wrong.</h1>
    <p class="hero-sub">An error occurred while processing your request. Please try again.</p>
    @if (Model.ShowRequestId)
    {
        <p class="text-secondary">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn-link-accent" asp-controller="Home" asp-action="Index">Back to home</a>
</section>

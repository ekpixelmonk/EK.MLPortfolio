{
  "modelFile": "model.onnx",
  "modelVersion": "1.0.0",
  "inputs": [
    {
      "type": "number",
      "name": "market_return_pct",
      "label": "Market return today (%)",
      "min": -5,
      "max": 5,
      "step": 0.1,
      "default": 0.5,
      "help": "Daily return of the Nifty 50"
    },
    {
      "type": "number",
      "name": "sector_return_pct",
      "label": "Sector return today (%)",
      "min": -5,
      "max": 5,
      "step": 0.1,
      "default": 0.4,
      "help": "Daily return of the Nifty Energy index"
    },
    {
      "type": "number",
      "name": "volume_ratio",
      "label": "Volume vs 20-day average (x)",
      "min": 0.2,
      "max": 4,
      "step": 0.1,
      "default": 1.0,
      "help": "1.0 means normal trading volume"
    }
  ],
  "outputs": {
    "type": "regression",
    "unit": "%"
  },
  "presets": [
    {
      "name": "Strong market day",
      "values": {
        "market_return_pct": 2.1,
        "sector_return_pct": 1.8,
        "volume_ratio": 1.6
      }
    },
    {
      "name": "Sell-off",
      "values": {
        "market_return_pct": -3.2,
        "sector_return_pct": -2.6,
        "volume_ratio": 2.8
      }
    },
    {
      "name": "Quiet day",
      "values": {
        "market_return_pct": 0.1,
        "sector_return_pct": 0.0,
        "volume_ratio": 0.7
      }
    }
  ]
}

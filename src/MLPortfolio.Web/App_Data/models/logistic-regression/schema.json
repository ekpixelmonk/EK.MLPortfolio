    { "name": "previous_score", "label": "Previous exam score", "type": "number", "min": 0, "max": 100, "default": 60 },
    { "name": "tutoring", "label": "Tutoring", "type": "select", "options": ["none", "weekly", "daily"], "default": "none" }
  ],
  "outputs": { "type": "classification", "labels": ["Fail", "Pass"] },
  "presets": [
    { "name": "Well prepared", "values": { "hours_studied": 22, "attendance_pct": 96, "previous_score": 82, "tutoring": "weekly" } },
    { "name": "At risk", "values": { "hours_studied": 3, "attendance_pct": 55, "previous_score": 38, "tutoring": "none" } }

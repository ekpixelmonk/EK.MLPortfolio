  "modelFile": "model.onnx",
  "modelVersion": "0.0.0-draft",
  "inputs": [
    { "name": "hours_studied", "label": "Hours studied per week", "type": "number", "min": 0, "max": 40, "step": 0.5, "default": 10, "help": "Self-study time outside class" },

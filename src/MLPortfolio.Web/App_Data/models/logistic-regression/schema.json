{
  "modelFile": "model.onnx",
  "modelVersion": "1.0.0",
  "inputs": [
    {
      "type": "number",
      "name": "annual_income_k",
      "label": "Annual income (thousands)",
      "min": 10,
      "max": 300,
      "step": 1,
      "default": 60,
      "help": "Gross yearly income, in thousands"
    },
    {
      "type": "number",
      "name": "debt_to_income_pct",
      "label": "Debt-to-income ratio (%)",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 30,
      "help": "Monthly debt payments as a share of monthly income"
    },
    {
      "type": "number",
      "name": "credit_history_years",
      "label": "Credit history (years)",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 8
    },
    {
      "type": "number",
      "name": "late_payments_12m",
      "label": "Late payments (last 12 months)",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0
    },
    {
      "name": "employment",
      "label": "Employment",
      "type": "select",
      "options": [
        "salaried",
        "self-employed",
        "unemployed"
      ],
      "default": "salaried"
    }
  ],
  "outputs": {
    "type": "classification",
    "labels": [
      "Repaid",
      "Default"
    ]
  },
  "presets": [
    {
      "name": "Low risk",
      "values": {
        "annual_income_k": 120,
        "debt_to_income_pct": 15,
        "credit_history_years": 15,
        "late_payments_12m": 0,
        "employment": "salaried"
      }
    },
    {
      "name": "High risk",
      "values": {
        "annual_income_k": 28,
        "debt_to_income_pct": 62,
        "credit_history_years": 2,
        "late_payments_12m": 5,
        "employment": "unemployed"
      }
    }
  ]
}
